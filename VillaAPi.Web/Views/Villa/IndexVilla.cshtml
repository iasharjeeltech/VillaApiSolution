@model List<VillaDto>
@using VillaApi.Web.Models.Dto.Villa

<table class="table table-bordered table-hover table-striped">
	<thead>
		<tr>
			<th>Name</th>
			<th>Details</th>
			<th>Occupancy</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var villaDto in Model){
			<tr>
				<td>@villaDto.Name</td>
				<td>@villaDto.Details</td>
				<td>@villaDto.Occupancy</td>
			</tr>
		}
	</tbody>
</table>